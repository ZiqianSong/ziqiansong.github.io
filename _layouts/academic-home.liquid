<!doctype html>
<html lang="{{ site.lang }}">
  <head>
    {% include head.liquid %}
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Source+Serif+Pro:ital,wght@0,400;0,700;1,400;1,700&display=swap"
    >
    <link rel="stylesheet" href="{{ '/assets/css/academic-home.css' | relative_url | bust_file_cache }}">
  </head>
  <body class="academic-home">
    <a class="academic-skip-link" href="#main-content">Skip to content</a>
    <div class="academic-shell">
      <aside class="academic-sidebar" aria-label="Profile">
        <h1>
          <a href="{{ '/' | relative_url }}">{{ site.data.cv.cv.name }}</a>
        </h1>
        <div class="academic-portrait">
          <img
            src="{{ '/assets/img/ziqian-song-clean.jpg' | relative_url }}"
            alt="Ziqian Song"
            width="180"
            height="210"
          >
        </div>
        <p class="academic-affiliation">
          Department of Economics<br>
          <strong>Sciences Po</strong>
          <a class="academic-email" href="mailto:{{ site.data.cv.cv.email }}">{{ site.data.cv.cv.email }}</a>
        </p>
        <p class="academic-address">
          28 rue des Saints-Pères<br>
          75007 Paris, France
        </p>
        <nav class="academic-navigation" aria-label="Main navigation">
          <a href="#research" aria-current="page">Research</a>
          <a href="#cv">Curriculum Vitae</a>
          <a href="#teaching">Teaching</a>
        </nav>
      </aside>
      <main class="academic-content" id="main-content">
        {{ content }}
      </main>
    </div>
    {% include footer.liquid %}
    <script defer src="{{ '/assets/js/academic-home.js' | relative_url }}"></script>
  </body>
</html>
