<ul class="academic-education">
  {% for entry in site.data.cv.cv.sections.Education %}
    <li>
      <svg class="academic-degree-icon" viewBox="0 0 24 24" aria-hidden="true">
        <path fill="currentColor" d="M12 3 1 8l11 5 9-4.09V16h2V8L12 3ZM5 12v5c4 3 10 3 14 0v-5l-7 3-7-3Z" />
      </svg>
      <div>
        <span>{{ entry.degree }} in {{ entry.area }}, {{ entry.date }}</span><br>
        <span class="academic-institution">{{ entry.institution }}</span><br>
        <span class="academic-location">{{ entry.location }}</span>
      </div>
    </li>
  {% endfor %}
</ul>
